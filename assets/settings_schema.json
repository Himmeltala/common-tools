[
  {
    "key": "interface",
    "label": "界面",
    "groups": [
      {
        "label": "主题",
        "settings": [
          {
            "key": "theme",
            "label": "界面主题",
            "type": "combo",
            "default": "dark",
            "options": [
              { "label": "暗色主题", "value": "dark" },
              { "label": "亮色主题", "value": "light" }
            ],
            "description": "选择程序整体外观主题，暗色护眼、亮色清晰"
          }
        ]
      }
    ]
  },
  {
    "key": "notification",
    "label": "通知",
    "groups": [
      {
        "label": "通用",
        "settings": [
          {
            "key": "notification.enabled",
            "label": "启用系统通知",
            "type": "checkbox",
            "default": true,
            "description": "关闭后不弹出 Windows 系统通知"
          },
          {
            "key": "notification.silent",
            "label": "静默通知",
            "type": "checkbox",
            "default": false,
            "description": "开启后通知不播放提示音"
          },
          {
            "key": "notification.timeoutType",
            "label": "显示时长",
            "type": "combo",
            "default": "default",
            "options": [
              { "label": "自动消失", "value": "default" },
              { "label": "常驻", "value": "never" }
            ],
            "description": "系统通知在屏幕上的停留方式"
          }
        ]
      }
    ]
  },
  {
    "key": "mermaid",
    "label": "Mermaid 工具",
    "groups": [
      {
        "label": "Mermaid 预览",
        "settings": [
          {
            "key": "mermaid.preview.filenameTemplate",
            "label": "导出文件名模板",
            "type": "text",
            "default": "{{year}}{{month}}{{day}}-{{hour}}{{minute}}{{second}}",
            "description": "导出文件的命名模板，支持变量插值：{{year}} 年、{{month}} 月、{{day}} 日、{{hour}} 时、{{minute}} 分、{{second}} 秒"
          }
        ]
      }
    ]
  }
]
